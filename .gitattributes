# Force LF line endings on everything that runs on the Pi.
# Without this, cloning/editing on Windows can introduce CRLF, which makes the
# kernel read a script's shebang as "/bin/bash\r" -> the boot service dies with
# status=203/EXEC and http://mega.local becomes unreachable (music still plays).
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.service text eol=lf
*.conf  text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.md    text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.svg text eol=lf
